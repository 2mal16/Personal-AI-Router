{
  "engine": "llama-swap",
  "display_name": "llama-swap",
  "manifest_version": 1,
  "runtime": {
    "mode": "external",
    "port": 10000,
    "ready": {
      "http": "http://127.0.0.1:{port}/v1/models",
      "status": 200,
      "timeout_s": 2
    }
  },
  "platforms": {
    "linux/amd64": {},
    "linux/arm64": {},
    "darwin/amd64": {},
    "darwin/arm64": {},
    "windows/amd64": {},
    "windows/arm64": {}
  },
  "actions": {
    "list_models": {
      "description": "List models configured in the externally managed llama-swap server.",
      "http": {
        "method": "GET",
        "path": "/v1/models"
      },
      "result": {
        "array": "data",
        "field": "id"
      }
    }
  }
}
